{
  "name": "Mercado_Equipo",
  "flow": [
    {
      "id": 1,
      "module": "gateway:CustomWebHook",
      "version": 1,
      "parameters": {
        "hook": 3064361,
        "maxResults": 1
      },
      "mapper": {},
      "metadata": {
        "designer": {
          "x": 0,
          "y": 0
        }
      }
    },
    {
      "id": 2,
      "module": "telegram:SendReplyMessage",
      "version": 1,
      "parameters": {
        "__IMTCONN__": 12331144
      },
      "mapper": {
        "text": "ALERTA DE ESCASEZ\nDemanda: {{1.demanda}}\nOferta: {{1.oferta}}\nPrecio de equilibrio: ${{1.precio}} por kg\nLa demanda supera a la oferta: el precio sube.",
        "chatId": "TU_CHAT_ID",
        "parseMode": "",
        "replyMarkup": "",
        "messageThreadId": "",
        "replyToMessageId": "",
        "replyMarkupAssembleType": "reply_markup_enter"
      },
      "metadata": {
        "designer": {
          "x": 300,
          "y": 0
        }
      },
      "filter": {
        "name": "Solo si hay escasez",
        "conditions": [
          [
            {
              "a": "{{1.estado}}",
              "b": "escasez",
              "o": "text:equal"
            }
          ]
        ]
      }
    }
  ],
  "metadata": {
    "instant": true,
    "version": 1,
    "designer": {
      "orphans": []
    },
    "scenario": {
      "dlq": false,
      "dataloss": false,
      "maxErrors": 3,
      "autoCommit": true,
      "roundtrips": 1,
      "sequential": false,
      "confidential": false,
      "freshVariables": false,
      "autoCommitTriggerLast": true
    }
  }
}